<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <ImageView
        android:id="@+id/ivRed"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivGreen"
        app:srcCompat="@android:drawable/alert_light_frame" />

    <Button
        android:id="@+id/btDisc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:onClick="onClick"
        android:text="DISCONNECT"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toBottomOf="@+id/btConBT" />

    <Button
        android:id="@+id/btConBT"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:onClick="onClick"
        android:text="BT"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/spDev"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btConBT"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btConBT" />

    <RadioButton
        android:id="@+id/rbConn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:clickable="false"
        android:enabled="true"
        android:text="CONNECTED"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btConBT" />

    <ImageView
        android:id="@+id/ivGreen"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="@+id/rbConn"
        app:layout_constraintTop_toBottomOf="@+id/rbConn"
        app:srcCompat="@android:drawable/alert_light_frame" />

    <TextView
        android:id="@+id/tvTaxi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:textAlignment="center"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivRed"
        app:layout_constraintEnd_toStartOf="@+id/ivRed"
        app:layout_constraintStart_toEndOf="@+id/ivGreen"
        app:layout_constraintTop_toTopOf="@+id/ivRed"
        app:layout_constraintVertical_bias="0.27999997" />

    <TextView
        android:id="@+id/tvTaxState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="@string/tax_state"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/tvTaxStateVal"
        app:layout_constraintTop_toBottomOf="@+id/ivGreen" />

    <TextView
        android:id="@+id/tvTaxStateVal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/border_maker"
        android:text="@string/tax_na"
        android:textAlignment="center"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTaxState" />

</androidx.constraintlayout.widget.ConstraintLayout>