<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:onClick="onClick"
    tools:context=".activity.MainActivity">

    <CheckBox
        android:id="@+id/cbK4"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:text="K4"
        app:layout_constraintStart_toEndOf="@+id/cbK3"
        app:layout_constraintTop_toTopOf="@+id/cbOP" />

    <CheckBox
        android:id="@+id/cbK3"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:text="K3"
        app:layout_constraintStart_toEndOf="@+id/cbK2"
        app:layout_constraintTop_toTopOf="@+id/cbOP" />

    <CheckBox
        android:id="@+id/cbK2"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:text="K2"
        app:layout_constraintStart_toEndOf="@+id/cbK1"
        app:layout_constraintTop_toTopOf="@+id/cbOP" />

    <CheckBox
        android:id="@+id/cbK1"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:text="K1"
        app:layout_constraintStart_toEndOf="@+id/cbOP"
        app:layout_constraintTop_toTopOf="@+id/cbOP" />

    <Button
        android:id="@+id/btCT2SendSp"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:text=">"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/spCt2Cmd"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toTopOf="@+id/spCt2Cmd" />

    <Spinner
        android:id="@+id/spCt2Cmd"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/btCT2SendSp"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/cbOP" />

    <Button
        android:id="@+id/btConBT"
        android:layout_width="53dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:onClick="onClick"
        android:text="BT"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/spDev"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spDev" />

    <EditText
        android:id="@+id/etCt2Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:maxLength="2"
        app:layout_constraintEnd_toStartOf="@+id/btCT2Send"
        app:layout_constraintStart_toEndOf="@+id/etCt2Cmd"
        app:layout_constraintTop_toTopOf="@+id/etCt2Cmd" />

    <Button
        android:id="@+id/btCT2Send"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:text=">"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/etCt2Cmd"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toTopOf="@+id/etCt2Cmd" />

    <EditText
        android:id="@+id/etCt2Cmd"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:maxLength="2"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/spCt2Cmd" />

    <Button
        android:id="@+id/btNL"
        android:layout_width="53dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:onClick="onClick"
        android:text="NL"
        android:textSize="12dp"
        app:layout_constraintEnd_toStartOf="@+id/btTx"
        app:layout_constraintTop_toTopOf="@+id/etText" />

    <Button
        android:id="@+id/btQr"
        android:layout_width="53dp"
        android:layout_height="wrap_content"
        android:onClick="onClick"
        android:text="QR"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toTopOf="@+id/etText" />

    <Button
        android:id="@+id/btTx"
        android:layout_width="53dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:onClick="onClick"
        android:text="TX"
        android:textSize="12dp"
        app:layout_constraintEnd_toStartOf="@+id/btQr"
        app:layout_constraintTop_toTopOf="@+id/etText" />

    <Button
        android:id="@+id/btButtonPress"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:text=">"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/cbOP"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toTopOf="@+id/cbOP" />

    <Button
        android:id="@+id/btLogClear"
        android:layout_width="53dp"
        android:layout_height="35dp"
        android:onClick="onClick"
        android:text="X"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="@+id/btDisc"
        app:layout_constraintTop_toTopOf="@+id/cbF4" />

    <TextView
        android:id="@+id/tvDisp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="N/A\nN/A\nN/A"
        android:textColor="@color/black"
        android:textSize="18dp"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toTopOf="@+id/textView2" />

    <Button
        android:id="@+id/btDisc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:onClick="onClick"
        android:text="Disconnect"
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintTop_toBottomOf="@+id/spDev" />

    <Spinner
        android:id="@+id/spDev"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btConBT"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Disp1:\nDisp2:\nStatus:"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/spDev" />

    <ListView
        android:id="@+id/lvLog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btConBT"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/cbF4">

    </ListView>

    <EditText
        android:id="@+id/etText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:text="HELLO WORLD!"
        app:layout_constraintEnd_toStartOf="@+id/btNL"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/etCt2Body" />

    <TextView
        android:id="@+id/tvPrinterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Printer: N/A"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/cbF4"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toTopOf="@+id/cbF4" />

    <CheckBox
        android:id="@+id/cbF4"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:text="F4 Printer"
        app:layout_constraintEnd_toStartOf="@+id/btLogClear"
        app:layout_constraintTop_toBottomOf="@+id/etText" />

    <CheckBox
        android:id="@+id/cbOP"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginTop="4dp"
        android:text="OP"
        app:layout_constraintStart_toStartOf="@+id/spDev"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

</androidx.constraintlayout.widget.ConstraintLayout>